# Platform network (REQUIRED for docker-compose.yml network interpolation).
# Must be the network Traefik routes on (this VPS: traefik_web; see
# traefik/traefik.yml provider network). This network is external and
# shared by every service Traefik routes to — it is not created by this
# compose file. See payments/DEPLOY.md for the fuller explanation.
PLATFORM_NETWORK=traefik_web

# Image tag for portal-ui, set by CI on each build/push to GHCR. Defaults
# to `latest` when unset.
PORTAL_UI_TAG=latest
