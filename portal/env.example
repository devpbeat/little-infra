# Platform network (REQUIRED for docker-compose.yml network interpolation).
# Must match `platform/.env`'s PLATFORM_NETWORK — the `platform` stack must
# be deployed first; this network is external and shared by every service
# Traefik routes to. See payments/DEPLOY.md for the fuller explanation.
PLATFORM_NETWORK=platform

# Image tag for portal-ui, set by CI on each build/push to GHCR. Defaults
# to `latest` when unset.
PORTAL_UI_TAG=latest
