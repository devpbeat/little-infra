    "components": {
        "schemas": {
            "Contract": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "readOnly": true
                    },
                    "customer": {
                        "type": "integer",
                        "readOnly": true
                    },
                    "template": {
                        "type": "integer",
                        "readOnly": true
                    },
                    "status": {
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/ContractStatusEnum"
                            }
                        ],
                        "readOnly": true
                    },
                    "external_envelope_id": {
                        "type": "string",
                        "readOnly": true
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    },
                    "signed_at": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true,
                        "nullable": true
                    }
                },
                "required": [
                    "created_at",
                    "customer",
                    "external_envelope_id",
                    "id",
                    "signed_at",
                    "status",
                    "template",
                    "updated_at"
                ]
            },
            "ContractStatusEnum": {
                "enum": [
                    "draft",
                    "generated",
                    "sent",
                    "signed",
                    "declined",
                    "voided",
                    "terminated"
                ],
                "type": "string",
                "description": "* `draft` - Draft\n* `generated` - Generated\n* `sent` - Sent\n* `signed` - Signed\n* `declined` - Declined\n* `voided` - Voided\n* `terminated` - Terminated"
            },
            "Customer": {
                "type": "object",
                "properties": {
                    "external_ref": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "email": {
                        "oneOf": [
                            {
                                "type": "string",
                                "format": "email",
                                "maxLength": 254
                            },
                            {
                                "type": "string",
                                "maxLength": 0
                            }
                        ]
                    },
                    "display_name": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    },
                    "contract": {
                        "type": "string",
                        "readOnly": true
                    },
                    "subscription": {
                        "type": "string",
                        "readOnly": true
                    }
                },
                "required": [
                    "contract",
                    "created_at",
                    "external_ref",
                    "subscription"
                ]
            },
            "PaginatedContractList": {
                "type": "object",
                "required": [
                    "count",
                    "results"
                ],
                "properties": {
                    "count": {
                        "type": "integer",
                        "example": 123
                    },
                    "next": {
                        "type": "string",
                        "nullable": true,
                        "format": "uri",
                        "example": "http://api.example.org/accounts/?page=4"
                    },
                    "previous": {
                        "type": "string",
                        "nullable": true,
                        "format": "uri",
                        "example": "http://api.example.org/accounts/?page=2"
                    },
                    "results": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Contract"
                        }
                    }
                }
            },
            "PaginatedCustomerList": {
                "type": "object",
                "required": [
                    "count",
                    "results"
                ],
                "properties": {
                    "count": {
                        "type": "integer",
                        "example": 123
                    },
                    "next": {
                        "type": "string",
                        "nullable": true,
                        "format": "uri",
                        "example": "http://api.example.org/accounts/?page=4"
                    },
                    "previous": {
                        "type": "string",
                        "nullable": true,
                        "format": "uri",
                        "example": "http://api.example.org/accounts/?page=2"
                    },
                    "results": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Customer"
                        }
                    }
                }
            },
            "PaginatedPaymentList": {
                "type": "object",
