# Platform network (REQUIRED for docker-compose.yml network interpolation,
# NOT just app config — docker compose reads this file for variable
# substitution too, since env_file and the compose .env are the same file
# here). Must be the network Traefik routes on (this VPS: traefik_web; see traefik/traefik.yml provider network).
# The `platform` stack must be deployed first; this network is external,
# not created by this compose file. See payments/DEPLOY.md.
PLATFORM_NETWORK=traefik_web

# Django
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=
# Optional: auto-create the admin user on first container boot.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
ALLOWED_HOSTS=payments.ignitesolutions.click,pay.ignitesolutions.click,localhost
CSRF_TRUSTED_ORIGINS=https://pay.ignitesolutions.click,https://payments.ignitesolutions.click

# Database (shared platform Postgres, dedicated `payments` database/role - design section 6 D2)
POSTGRES_DB=payments
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Pagopar (wired in Slice C)
PAGOPAR_PUBLIC_KEY=
# REQUIRED. Adapter.verify_webhook fails CLOSED when this is empty/unset
# (Slice E2 fix for review finding W4) — an unconfigured deployment can
# never accept a webhook, it will always 401. Never leave this blank in a
# live .env; a blank key does not mean "accept everything", it means
# "reject everything".
PAGOPAR_PRIVATE_KEY=
PAGOPAR_BASE_URL=https://api.pagopar.com
PAYMENT_GATEWAY=adapters.pagopar.adapter.PagoparAdapter

# Webhook path token (design section 5 layer 2 - defense in depth, not the real control)
WEBHOOK_PATH_TOKEN=

# DocuSign (optional in v1 - NullContractSigner is the default, design section 4)
# Set to adapters.docuseal.signer.DocuSealSigner to send real signature envelopes.
CONTRACT_SIGNER=adapters.fakes.fake_signer.NullContractSigner
# DocuSeal (self-hosted at the ln stack, same instance the contracts/ app uses)
DOCUSEAL_URL=
DOCUSEAL_PUBLIC_URL=
DOCUSEAL_API_TOKEN=

# Anthropic (upcoming: contract/template generation, not yet wired in this slice)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Image tag for the payments-ui dashboard container (default: latest)
PAYMENTS_UI_TAG=latest

# Outbound email for service notifications (optional; console backend if unset).
# DocuSeal sends signature emails itself with its own SMTP settings.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=
