# Placeholder for future product/plan API wiring (not used by this slice —
# the marketplace is hardcoded product data).
VITE_API_BASE_URL=/api/v1

# Clerk publishable key (from the Clerk dashboard → API Keys). This is the
# PUBLISHABLE key, safe to ship to the frontend/browser — it is not a secret.
# The Clerk SECRET key is NOT needed by this SPA (no server-side Clerk calls
# happen here) and must never be set in this file or committed anywhere.
# Required at runtime: main.tsx throws a clear error if it is missing when
# the app boots in the browser. The build itself succeeds without it.
VITE_CLERK_PUBLISHABLE_KEY=
